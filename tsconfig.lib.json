{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "types": [],
    "allowImportingTsExtensions": false
  },
  "include": ["src/index.ts", "src/components/**/*.ts", "src/components/**/*.tsx", "src/theme/**/*.ts"],
  "exclude": ["**/*.stories.tsx", "**/*.test.tsx", "src/test", "src/main.tsx"]
}
