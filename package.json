{
  "name": "@sorayasm/vietri-ds",
  "private": false,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:lib",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.lib.json",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:storybook": "storybook build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "26.0.0",
    "storybook": "^10.6.6",
    "typescript": "5.7.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@mui/material": "6.4.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@storybook/addon-a11y": "^10.6.6",
    "axe-core": "^4.10.0",
    "lucide-react": "^1.41.0"
  },
  "description": "A themeable React and MUI design system for the Soraya Sacaan portfolio projects.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": ">=6.0.0 <7.0.0",
    "@emotion/react": ">=11.0.0",
    "@emotion/styled": ">=11.0.0",
    "lucide-react": ">=0.400.0"
  },
  "keywords": [
    "design-system",
    "react",
    "mui",
    "accessibility",
    "storybook"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorayasm/vietri-ds.git"
  },
  "homepage": "https://github.com/sorayasm/vietri-ds#readme",
  "bugs": {
    "url": "https://github.com/sorayasm/vietri-ds/issues"
  },
  "author": "Soraya Sacaan"
}
